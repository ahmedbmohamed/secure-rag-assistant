# Copy to .env and change every value marked CHANGE.
POSTGRES_PASSWORD=CHANGE-a-long-random-password
SRAG_MANIFEST_KEY=CHANGE-another-long-random-secret

# Local LLM served by Ollama on the internal network
SRAG_OLLAMA_MODEL=qwen2.5:3b
# Pin the image version you have tested, for example ollama/ollama:0.12.3
OLLAMA_IMAGE=ollama/ollama:latest
# Optional: pin the model digest shown by `docker compose exec ollama ollama list`
# SRAG_OLLAMA_MODEL_DIGEST=

# Cloud mode is off. Turning it on sends masked prompts to a third party.
# SRAG_LLM_MODE=cloud
# SRAG_ALLOW_CLOUD=true
# SRAG_CLOUD_BASE_URL=https://api.groq.com/openai/v1
# SRAG_CLOUD_MODEL=llama-3.3-70b-versatile
# SRAG_CLOUD_API_KEY=
